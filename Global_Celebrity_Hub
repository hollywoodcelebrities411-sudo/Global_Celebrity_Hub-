function toggleTC(){
    const body = document.getElementById('tcBody');
    const btn  = document.getElementById('tcToggleBtn');
    const label = document.getElementById('tcBtnLabel');
    const isOpen = body.classList.contains('tc-open');

    if(isOpen){
        body.classList.remove('tc-open');
        btn.classList.remove('open');
        btn.setAttribute('aria-expanded','false');
        body.setAttribute('aria-hidden','true');
        label.textContent = 'See More';
    } else {
        body.classList.add('tc-open');
        btn.classList.add('open');
        btn.setAttribute('aria-expanded','true');
        body.setAttribute('aria-hidden','false');
        label.textContent = 'See Less';
    }
}

