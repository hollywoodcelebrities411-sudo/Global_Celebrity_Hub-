function buildMassiveRosterDatabase(){
    const db=[];
    compactCelebrityStrings.forEach(e=>{const p=e.split('|');if(p.length===2)db.push({name:p[0],category:p[1]});});
    const cats=["actor","musician","presenter","speaker"];
    const sur=["Smith","Johnson","Williams","Brown","Jones","Garcia","Miller","Davis","Rodriguez","Martinez","Hernandez","Lopez","Gonzalez","Wilson","Anderson","Thomas","Taylor","Moore","Jackson","Martin"];
    const male=["James","John","Robert","Michael","William","David","Richard","Joseph","Thomas","Charles","Christopher","Daniel","Matthew","Anthony","Mark","Donald","Steven","Paul","Andrew","Joshua"];
    const female=["Mary","Patricia","Jennifer","Linda","Elizabeth","Barbara","Susan","Jessica","Sarah","Karen","Lisa","Nancy","Betty","Sandra","Margaret","Ashley","Kimberly","Emily","Donna","Michelle"];
    let c=0;
    while(db.length<1010){const m=c%2===0;const fn=m?male[c%male.length]:female[c%female.length];const sn=sur[(c*3)%sur.length];db.push({name:`${fn} ${sn} (Pro-Elite VIP)`,category:cats[(c*7)%cats.length]});c++;}
    return db;
}
