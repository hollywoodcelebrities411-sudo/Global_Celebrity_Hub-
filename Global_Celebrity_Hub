/* ── FORM COMBOBOX ── */
function setupFormSearchableDropdown(){
    const inp=document.getElementById('celebrityFormSearch');
    const panel=document.getElementById('celebrityFormOptions');
    const hidden=document.getElementById('celebritySelect');
    const wrap=document.getElementById('formComboboxWrapper');
    const sorted=[...celebrityRosterDatabase].sort((a,b)=>a.name.localeCompare(b.name));
    const tagMap={actor:"Actor",musician:"Music",presenter:"Media",speaker:"Icon"};
    function render(q=""){
        panel.innerHTML="";
        const f=sorted.filter(c=>c.name.toLowerCase().includes(q.toLowerCase().trim()));
        if(!f.length){panel.innerHTML=`<div class="combobox-empty-message">No matching celebrities found</div>`;return;}
        const fragment = document.createDocumentFragment();
        f.slice(0,150).forEach(c=>{
            const n=document.createElement('div');n.className="combobox-option-node";
            n.innerHTML=`<span>${c.name}</span><span class="node-category">${tagMap[c.category]||"VIP"}</span>`;
            n.addEventListener('mousedown',e=>{e.preventDefault();inp.value=c.name;hidden.value=c.name;close();});
            fragment.appendChild(n);
        });
        panel.appendChild(fragment);
        if(f.length>150){const e=document.createElement('div');e.style.cssText="padding:10px;font-size:10px;text-align:center;color:var(--sky);pointer-events:none;";e.innerText=`Type to narrow ${f.length-150} more…`;panel.appendChild(e);}
    }
    function open(){panel.style.display="block";wrap.classList.add('active');render(inp.value);}
    function close(){panel.style.display="none";wrap.classList.remove('active');}
    inp.addEventListener('focus',open);
    inp.addEventListener('input',()=>{open();hidden.value="";});
    inp.addEventListener('blur',()=>{
        setTimeout(()=>{
            close();
            const m=sorted.find(c=>c.name.toLowerCase()===inp.value.toLowerCase().trim());
            if(m){inp.value=m.name;hidden.value=m.name;}
            else if(inp.value!==""){inp.value="";inp.placeholder="Please select a celebrity from the list!";}
        },220);
    });
}

