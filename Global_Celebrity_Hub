<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>GLOBAL CELEBRITIES HUB | VIP ELITE</title>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;900&family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

<style>
:root {
  /* ── CORE COLORS ── */
  --sky:         #0ea5e9;
  --sky-light:   #bae6fd;
  --sky-mid:     #38bdf8;
  --sky-dark:    #0369a1;
  --sky-deep:    #082f49;
  --body-bg:     #f0f9ff;
  --body-bg2:    #e0f2fe;
  --white:       #ffffff;
  --text-dark:   #0c1a2e;
  --text-body:   #1e3a5f;
  --text-soft:   #4a7fa5;
  --glass-sky:   rgba(14,165,233,0.08);
  --glass-sky-border: rgba(14,165,233,0.2);
  --shadow-sky:  0 20px 50px rgba(14,165,233,0.12);
  --radius-xl:   28px;
  --radius-lg:   18px;
  --radius-md:   12px;
  --transition:  all 0.45s cubic-bezier(0.16,1,0.3,1);
}

/* ── GLOBAL RESET & BASE ── */
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box;word-wrap:break-word;overflow-wrap:break-word}
html{scroll-behavior:smooth;scroll-padding-top:90px;background:var(--body-bg)}
body{font-family:'Poppins',sans-serif;color:var(--text-dark);overflow-x:hidden;line-height:1.75}

/* ── PROGRESS BAR ── */
#progressBar {
  position: fixed;
  top: 0;
  left: 0;
  height: 3px;
  background: linear-gradient(90deg, var(--sky-light), var(--sky), var(--sky-dark));
  box-shadow: 0 0 12px var(--sky);
  z-index: 9999;
  transition: width 0.1s ease-out;
  pointer-events: none;
}

/* ── BACK TO TOP ── */
.back-to-top {
  position: fixed;
  bottom: 30px;
  right: 30px;
  width: 52px;
  height: 52px;
  background: rgba(255,255,255,0.95);
  border: 2px solid var(--sky);
  color: var(--sky-dark);
  border-radius: 50%;
  font-size: 22px;
  display: none;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  box-shadow: 0 10px 30px rgba(14,165,233,0.25);
  z-index: 999;
  transition: var(--transition);
}
.back-to-top:hover {
  transform: translateY(-4px) scale(1.08);
  background: white;
  box-shadow: 0 15px 40px rgba(14,165,233,0.35);
}

/* ── HERO PARTICLES ── */
#heroParticles {
  position: absolute;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
  z-index: 1;
}
.particle {
  position: absolute;
  background: rgba(186, 230, 253, 0.75);
  border-radius: 50%;
  box-shadow: 0 0 10px var(--sky-light);
  animation: floatUp linear infinite;
}
@keyframes floatUp {
  0% { transform: translateY(120px) scale(0.6); opacity: 0; }
  15% { opacity: 0.85; }
  85% { opacity: 0.85; }
  100% { transform: translateY(-900px) scale(0.3); opacity: 0; }
}

/* ── CONTAINER ── */
.container{width:100%;max-width:1400px;margin:0 auto;padding:0 clamp(16px,4vw,40px)}

/* ── SCROLLBAR ── */
::-webkit-scrollbar{width:8px}
::-webkit-scrollbar-track{background:var(--sky-deep)}
::-webkit-scrollbar-thumb{background:linear-gradient(180deg,var(--sky),var(--sky-dark));border-radius:8px;border:2px solid var(--sky-deep)}

/* ── 3D LOGO GLOBE ── */
.logo-orbit-wrap{position:relative;width:64px;height:64px;display:flex;align-items:center;justify-content:center;flex-shrink:0;perspective:350px;}
.logo-orbit-wrap::before{content:'';position:absolute;width:90px;height:90px;border-radius:50%;background:radial-gradient(circle,rgba(14,165,233,0.22) 0%,transparent 70%);animation:outerPulse 3s ease-in-out infinite alternate;}
@keyframes outerPulse{0%{transform:scale(1);opacity:0.5}100%{transform:scale(1.18);opacity:1}}
.logo-globe{width:52px;height:52px;border-radius:50%;position:relative;z-index:3;background:radial-gradient(circle at 38% 32%, rgba(186,230,253,0.9) 0%,var(--sky) 35%,#0369a1 65%,#082f49 100%);box-shadow:inset -10px -8px 20px rgba(0,0,0,0.4),inset 4px 4px 12px rgba(186,230,253,0.4),0 0 20px rgba(14,165,233,0.55),0 0 45px rgba(3,105,161,0.3);animation:globeSpin 7s linear infinite;transform-style:preserve-3d;overflow:hidden;}
.logo-globe::before{content:'';position:absolute;inset:0;border-radius:50%;background:linear-gradient(transparent 24%,rgba(0,0,0,0.12) 25%,transparent 26%),linear-gradient(transparent 49%,rgba(0,0,0,0.12) 50%,transparent 51%),linear-gradient(transparent 74%,rgba(0,0,0,0.12) 75%,transparent 76%);animation:gridSlide 3.5s linear infinite;}
.logo-globe::after{content:'';position:absolute;inset:0;border-radius:50%;background:repeating-linear-gradient(90deg,transparent 0%,transparent 14%,rgba(0,0,0,0.08) 14.5%,transparent 15%);animation:longSlide 7s linear infinite;}
@keyframes globeSpin{0%{transform:rotateY(0deg) rotateX(12deg)}100%{transform:rotateY(360deg) rotateX(12deg)}}
@keyframes gridSlide{0%{background-position:0 0%}100%{background-position:0 100%}}
@keyframes longSlide{0%{background-position:0% 0}100%{background-position:100% 0}}
.logo-text-overlay{position:absolute;z-index:10;font-family:'Cinzel',serif;font-size:13px;font-weight:900;letter-spacing:2px;color:#fff;text-shadow:0 1px 8px rgba(0,0,0,0.6),0 0 12px rgba(14,165,233,0.8);pointer-events:none;top:50%;left:50%;transform:translate(-50%,-50%);}
.orbit-ring{position:absolute;border-radius:50%;border:1.5px solid rgba(14,165,233,0.65);z-index:5;pointer-events:none;}
.orbit-ring-1{width:72px;height:72px;top:50%;left:50%;margin:-36px 0 0 -36px;animation:orbitEq 4s linear infinite;box-shadow:0 0 6px rgba(14,165,233,0.4);}
.orbit-ring-2{width:72px;height:24px;top:50%;left:50%;margin:-12px 0 0 -36px;border-color:rgba(56,189,248,0.5);animation:orbitTilt 6s linear infinite reverse;}
.orbit-ring-3{width:24px;height:72px;top:50%;left:50%;margin:-36px 0 0 -12px;border-color:rgba(14,165,233,0.3);animation:orbitTilt2 5s linear infinite;}
.orbit-dot{position:absolute;width:6px;height:6px;background:#bae6fd;border-radius:50%;box-shadow:0 0 8px var(--sky);top:-3px;left:50%;margin-left:-3px;transform-origin:50% 39px;animation:dotSpin 4s linear infinite;}
@keyframes orbitEq{0%{transform:rotateX(75deg) rotateZ(0deg)}100%{transform:rotateX(75deg) rotateZ(360deg)}}
@keyframes orbitTilt{0%{transform:rotateZ(-25deg) rotateX(80deg) rotateZ(0deg)}100%{transform:rotateZ(-25deg) rotateX(80deg) rotateZ(360deg)}}
@keyframes orbitTilt2{0%{transform:rotateZ(65deg) rotateY(70deg) rotateZ(0deg)}100%{transform:rotateZ(65deg) rotateY(70deg) rotateZ(360deg)}}
@keyframes dotSpin{0%{transform:rotate(0deg) translateX(0)}100%{transform:rotate(360deg) translateX(0)}}

/* ── NAVIGATION ── */
nav{position:fixed;top:0;left:0;width:100%;z-index:1000;background:rgba(255,255,255,0.88);backdrop-filter:blur(28px);-webkit-backdrop-filter:blur(28px);border-bottom:1px solid rgba(14,165,233,0.2);transition:var(--transition);}
.nav-container{display:flex;justify-content:space-between;align-items:center;padding:16px 0;gap:20px;}
.nav-brand{display:flex;align-items:center;gap:14px;text-decoration:none}
.nav-brand-text{font-family:'Cinzel',serif;font-size:clamp(14px,1.8vw,20px);font-weight:900;letter-spacing:3px;background:linear-gradient(135deg,var(--sky-dark) 0%,var(--sky) 50%,var(--sky-dark) 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;white-space:nowrap;}
nav ul{display:flex;align-items:center;gap:clamp(14px,2.5vw,32px);list-style:none}
nav ul li a{text-decoration:none;color:var(--text-body);font-size:clamp(11px,1vw,13px);font-weight:600;letter-spacing:1.5px;text-transform:uppercase;transition:color 0.3s;position:relative;padding:6px 0;}
nav ul li a::after{content:'';position:absolute;bottom:0;left:50%;width:0;height:2px;background:linear-gradient(90deg,var(--sky),var(--sky-dark));transition:all 0.3s cubic-bezier(0.4,0,0.2,1);transform:translateX(-50%);}
nav ul li a:hover{color:var(--sky-dark)}
nav ul li a:hover::after{width:100%}
.hamburger{display:none;flex-direction:column;gap:5px;cursor:pointer;background:none;border:none;padding:8px;z-index:1100;}
.hamburger span{display:block;width:24px;height:2px;background:var(--sky);border-radius:2px;transition:var(--transition);transform-origin:center;}
.hamburger.open span:nth-child(1){transform:translateY(7px) rotate(45deg)}
.hamburger.open span:nth-child(2){opacity:0;transform:scaleX(0)}
.hamburger.open span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}
.mobile-menu{display:none;position:fixed;inset:0;background:rgba(8,30,60,0.98);backdrop-filter:blur(30px);z-index:999;flex-direction:column;align-items:center;justify-content:center;gap:36px;opacity:0;pointer-events:none;transition:opacity 0.4s ease;}
.mobile-menu.open{display:flex;opacity:1;pointer-events:all}
.mobile-menu a{font-family:'Cinzel',serif;font-size:clamp(22px,5vw,36px);color:rgba(255,255,255,0.8);text-decoration:none;letter-spacing:3px;transition:color 0.3s;}
.mobile-menu a:hover{color:var(--sky)}

/* ── HERO ── */
.hero{min-height:100vh;display:flex;align-items:center;position:relative;padding:clamp(120px,15vh,180px) 0 80px;background:linear-gradient(to bottom,rgba(2,30,60,0.55) 0%,rgba(8,47,73,0.85) 100%),url('https://images.unsplash.com/photo-1511578314322-379afb476865?q=80&w=2000&auto=format&fit=crop');background-size:cover;background-position:center;background-attachment:fixed;overflow:hidden;}
.hero::after{content:'';position:absolute;bottom:0;left:0;width:100%;height:180px;background:linear-gradient(to top,#f0f9ff,transparent);pointer-events:none;}
.hero-content{max-width:980px;margin:0 auto;text-align:center;animation:heroIn 1.3s cubic-bezier(0.16,1,0.3,1) both;position:relative;z-index:2;}
@keyframes heroIn{from{opacity:0;transform:translateY(30px)}to{opacity:1;transform:translateY(0)}}

/* ── 3D ELITE BADGE ── */
.hero-badge{display:inline-flex;align-items:center;padding:14px 36px;border-radius:50px;border:1px solid rgba(186,230,253,0.5);color:#fff;font-size:12px;font-weight:800;letter-spacing:4px;text-transform:uppercase;margin-bottom:36px;background:linear-gradient(135deg,rgba(14,165,233,0.25),rgba(3,105,161,0.25));position:relative;transform-style:preserve-3d;animation:badge3D 6s ease-in-out infinite, pulseBorderBlue 3s infinite alternate;perspective:600px;overflow:hidden;}
.hero-badge::before{content:'';position:absolute;inset:0;border-radius:50px;background:linear-gradient(90deg,transparent 0%,rgba(186,230,253,0.25) 40%,rgba(255,255,255,0.12) 50%,rgba(186,230,253,0.25) 60%,transparent 100%);animation:shineSlide 2.5s ease-in-out infinite;}
@keyframes badge3D{0%{transform:perspective(600px) rotateX(0deg) rotateY(0deg) scale(1);box-shadow:0 4px 30px rgba(14,165,233,0.3),0 0 0 1px rgba(14,165,233,0.3);}20%{transform:perspective(600px) rotateX(8deg) rotateY(-5deg) scale(1.04);box-shadow:0 20px 50px rgba(14,165,233,0.5),0 0 40px rgba(56,189,248,0.2);}40%{transform:perspective(600px) rotateX(-5deg) rotateY(8deg) scale(1.02);box-shadow:0 12px 40px rgba(14,165,233,0.4),0 0 60px rgba(56,189,248,0.15);}60%{transform:perspective(600px) rotateX(6deg) rotateY(6deg) scale(1.05);box-shadow:0 25px 60px rgba(14,165,233,0.55),0 0 80px rgba(56,189,248,0.2);}80%{transform:perspective(600px) rotateX(-3deg) rotateY(-8deg) scale(1.03);box-shadow:0 15px 45px rgba(14,165,233,0.45);}100%{transform:perspective(600px) rotateX(0deg) rotateY(0deg) scale(1);box-shadow:0 4px 30px rgba(14,165,233,0.3);}}
@keyframes shineSlide{0%{transform:translateX(-100%) skewX(-15deg)}60%{transform:translateX(200%) skewX(-15deg)}100%{transform:translateX(200%) skewX(-15deg)}}
@keyframes pulseBorderBlue{0%{border-color:rgba(14,165,233,0.3);box-shadow:0 0 15px rgba(14,165,233,0.15)}100%{border-color:rgba(186,230,253,0.8);box-shadow:0 0 35px rgba(14,165,233,0.4),0 0 70px rgba(14,165,233,0.15)}}
.hero h1{font-family:'Cinzel',serif;font-size:clamp(36px,7.5vw,96px);font-weight:900;line-height:1.05;letter-spacing:clamp(1px,0.3vw,4px);margin-bottom:28px;background:linear-gradient(to bottom,#ffffff 15%,#bae6fd 50%,#38bdf8 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;filter:drop-shadow(0 4px 20px rgba(0,0,0,0.5));}
.hero p{font-size:clamp(14px,1.8vw,19px);color:rgba(240,249,255,0.92);max-width:820px;margin:0 auto 48px;font-weight:300;line-height:1.85;}
.hero-btns{display:flex;justify-content:center;gap:20px;flex-wrap:wrap}

/* ── BUTTONS ── */
.btn{display:inline-flex;align-items:center;justify-content:center;padding:clamp(14px,2vw,20px) clamp(24px,3.5vw,44px);border-radius:14px;text-decoration:none;font-weight:700;font-size:clamp(11px,1.1vw,14px);letter-spacing:2px;text-transform:uppercase;transition:var(--transition);min-width:200px;position:relative;overflow:hidden;border:none;cursor:pointer;font-family:'Poppins',sans-serif;}
.btn-primary{background:linear-gradient(135deg,var(--sky) 0%,var(--sky-dark) 100%);color:#fff;box-shadow:0 10px 35px rgba(14,165,233,0.35);}
.btn-primary::before{content:'';position:absolute;top:0;left:-150%;width:110%;height:100%;background:linear-gradient(90deg,transparent,rgba(255,255,255,0.28),transparent);transform:skewX(-25deg);transition:0.7s;}
.btn-primary:hover::before{left:150%}
.btn-primary:hover{transform:translateY(-5px) scale(1.02);box-shadow:0 18px 45px rgba(14,165,233,0.5);background:linear-gradient(135deg,var(--sky-mid) 0%,var(--sky) 50%,var(--sky-dark) 100%)}
.btn-secondary{background:rgba(255,255,255,0.12);border:1px solid rgba(186,230,253,0.4);color:#fff;backdrop-filter:blur(15px);}
.btn-secondary:hover{background:rgba(14,165,233,0.2);border-color:rgba(186,230,253,0.8);transform:translateY(-5px);color:#bae6fd}
.btn-sky{background:linear-gradient(135deg,var(--sky) 0%,var(--sky-dark) 100%);color:#fff;box-shadow:0 10px 35px rgba(14,165,233,0.3);}
.btn-sky::before{content:'';position:absolute;top:0;left:-150%;width:110%;height:100%;background:linear-gradient(90deg,transparent,rgba(255,255,255,0.3),transparent);transform:skewX(-25deg);transition:0.7s;}
.btn-sky:hover::before{left:150%}
.btn-sky:hover{transform:translateY(-5px) scale(1.02);box-shadow:0 18px 45px rgba(14,165,233,0.45);background:linear-gradient(135deg,var(--sky-mid) 0%,var(--sky) 100%)}

/* ── BODY CONTENT ── */
.body-content{background:linear-gradient(180deg,#f0f9ff 0%,#e0f2fe 15%,#f8fdff 35%,#e0f2fe 55%,#f0f9ff 70%,#e8f5fe 85%,#f0f9ff 100%);position:relative;overflow:hidden;}
.body-content::before{content:'';position:absolute;inset:0;pointer-events:none;z-index:0;background:radial-gradient(ellipse 80% 40% at 20% 20%,rgba(14,165,233,0.08) 0%,transparent 60%),radial-gradient(ellipse 60% 50% at 80% 60%,rgba(56,189,248,0.07) 0%,transparent 60%),radial-gradient(ellipse 50% 30% at 50% 90%,rgba(14,165,233,0.05) 0%,transparent 60%);}
.body-content > *{position:relative;z-index:1}
.body-content section{padding:clamp(80px,10vw,130px) 0;position:relative}

.sky-section .section-title-wrap{text-align:center;margin-bottom:clamp(50px,7vw,85px)}
.sky-section .section-title{font-family:'Cinzel',serif;font-size:clamp(28px,4.5vw,56px);font-weight:700;letter-spacing:2px;background:linear-gradient(135deg,var(--sky-dark) 0%,var(--sky) 50%,var(--sky-dark) 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;margin-bottom:18px;}
.sky-section .section-subtitle{max-width:780px;margin:0 auto;color:var(--text-body);font-size:clamp(13px,1.4vw,16px);font-weight:400;line-height:1.85;}

.sky-divider{display:flex;align-items:center;gap:20px;max-width:320px;margin:0 auto 16px;}
.sky-divider::before,.sky-divider::after{content:'';flex:1;height:1.5px;background:linear-gradient(90deg,transparent,var(--sky),transparent);}
.sky-divider span{color:var(--sky);font-size:18px;animation:rotateStar 6s linear infinite;}
@keyframes rotateStar{to{transform:rotate(360deg)}}

/* ── SKY PANELS ── */
.sky-panel{background:rgba(255,255,255,0.7);border:1px solid rgba(14,165,233,0.2);border-radius:var(--radius-xl);padding:clamp(32px,4vw,50px) clamp(24px,3vw,38px);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);transition:var(--transition);position:relative;overflow:hidden;box-shadow:0 8px 32px rgba(14,165,233,0.1), 0 2px 8px rgba(0,0,0,0.06);}
.sky-panel::before{content:'';position:absolute;top:0;left:0;width:100%;height:4px;background:linear-gradient(90deg,var(--sky-light),var(--sky),var(--sky-dark));border-radius:var(--radius-xl) var(--radius-xl) 0 0;}
.sky-panel::after{content:'';position:absolute;inset:0;border-radius:inherit;background:linear-gradient(135deg,rgba(14,165,233,0.06),transparent 50%);opacity:0;transition:opacity 0.5s ease;pointer-events:none;}
.sky-panel:hover{transform:translateY(-10px) scale(1.015);border-color:rgba(14,165,233,0.4);box-shadow:0 24px 60px rgba(14,165,233,0.18),0 8px 20px rgba(0,0,0,0.08)}
.sky-panel:hover::after{opacity:1}
.sky-panel .panel-icon{font-size:2.4rem;margin-bottom:18px;display:block;filter:drop-shadow(0 0 8px rgba(14,165,233,0.5));}
.sky-panel h3{font-family:'Cinzel',serif;font-size:clamp(17px,2vw,22px);font-weight:700;color:var(--sky-dark);margin-bottom:16px;letter-spacing:1px;transition:color 0.3s;}
.sky-panel:hover h3{color:var(--sky)}
.sky-panel p{font-size:clamp(13px,1.2vw,15px);color:var(--text-body);font-weight:400;line-height:1.85;}
.about-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(20px,3vw,32px)}

/* ── ENTERTAINMENT ── */
.entertainment-section{padding:clamp(70px,9vw,120px) 0;overflow:hidden;position:relative;}
.entertainment-section::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 80% 60% at 50% 50%,rgba(14,165,233,0.07) 0%,transparent 70%);pointer-events:none;}
.ent-header{text-align:center;margin-bottom:50px}
.ent-header .ent-eyebrow{display:inline-block;font-size:11px;font-weight:700;letter-spacing:4px;text-transform:uppercase;color:var(--sky);margin-bottom:16px;}
.ent-header h2{font-family:'Cinzel',serif;font-size:clamp(26px,4vw,50px);font-weight:700;letter-spacing:2px;background:linear-gradient(135deg,var(--sky-dark) 0%,var(--sky) 50%,var(--sky-dark) 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;margin-bottom:14px;}
.ent-header p{max-width:680px;margin:0 auto;color:var(--text-body);font-size:clamp(13px,1.3vw,15px);font-weight:400;line-height:1.85}
.marquee-track{overflow:hidden;white-space:nowrap;border-top:1px solid rgba(14,165,233,0.2);border-bottom:1px solid rgba(14,165,233,0.2);padding:14px 0;margin-bottom:50px;background:rgba(14,165,233,0.05);mask-image:linear-gradient(90deg,transparent,#000 10%,#000 90%,transparent);}
.marquee-inner{display:inline-block;animation:marqueeScroll 28s linear infinite;font-size:12px;letter-spacing:3px;font-weight:700;text-transform:uppercase;color:var(--sky-dark);}
.marquee-inner span{margin:0 40px}
@keyframes marqueeScroll{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}
.slideshow-stage{position:relative;height:clamp(280px,45vw,560px);border-radius:var(--radius-xl);overflow:hidden;box-shadow:0 40px 100px rgba(14,165,233,0.2),0 10px 30px rgba(0,0,0,0.15);border:2px solid rgba(14,165,233,0.2);}
.slideshow-slide{position:absolute;inset:0;opacity:0;transition:opacity 1.4s ease,transform 1.4s cubic-bezier(0.16,1,0.3,1);transform:scale(1.03);}
.slideshow-slide.active{opacity:1;transform:scale(1)}
.slideshow-slide img{width:100%;height:100%;object-fit:cover;display:block;filter:brightness(0.65) saturate(1.1);}
.slide-overlay{position:absolute;inset:0;background:linear-gradient(to top,rgba(2,27,50,0.93) 0%,rgba(2,27,50,0.2) 60%,transparent 100%);}
.slide-info{position:absolute;bottom:0;left:0;right:0;padding:clamp(24px,4vw,48px);}
.slide-type-badge{display:inline-block;padding:6px 18px;border-radius:50px;border:1px solid rgba(14,165,233,0.5);color:var(--sky-light);font-size:10px;font-weight:700;letter-spacing:3px;text-transform:uppercase;background:rgba(14,165,233,0.15);margin-bottom:14px;backdrop-filter:blur(10px);}
.slide-title{font-family:'Cinzel',serif;font-size:clamp(18px,3.5vw,38px);font-weight:700;color:#fff;line-height:1.2;text-shadow:0 2px 20px rgba(0,0,0,0.8);}
.slide-desc{font-size:clamp(12px,1.2vw,15px);color:rgba(255,255,255,0.85);margin-top:8px;font-weight:300;}
.slideshow-dots{display:flex;justify-content:center;gap:10px;margin-top:24px;}
.slide-dot{width:8px;height:8px;border-radius:50%;background:rgba(14,165,233,0.25);border:1px solid rgba(14,165,233,0.5);cursor:pointer;transition:all 0.3s;}
.slide-dot.active{width:28px;border-radius:4px;background:var(--sky);border-color:var(--sky)}
.slideshow-thumbs{display:grid;grid-template-columns:repeat(auto-fill,minmax(clamp(100px,12vw,160px),1fr));gap:12px;margin-top:28px;}
.thumb-item{border-radius:var(--radius-md);overflow:hidden;cursor:pointer;position:relative;aspect-ratio:16/9;border:2px solid rgba(14,165,233,0.15);transition:var(--transition);}
.thumb-item img{width:100%;height:100%;object-fit:cover;filter:brightness(0.55) saturate(0.8);transition:var(--transition)}
.thumb-item:hover img,.thumb-item.active img{filter:brightness(0.9) saturate(1.2)}
.thumb-item::after{content:'';position:absolute;inset:0;border-radius:inherit;border:2px solid transparent;transition:border-color 0.3s;}
.thumb-item.active::after,.thumb-item:hover::after{border-color:var(--sky)}

/* ── STATS ── */
.stats{background:linear-gradient(135deg,rgba(14,165,233,0.08) 0%,rgba(255,255,255,0.5) 50%,rgba(14,165,233,0.08) 100%);}
.stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:clamp(16px,3vw,30px)}
.stat-box{text-align:center;padding:clamp(32px,5vw,55px) 20px;border-radius:var(--radius-lg);background:rgba(255,255,255,0.75);border:1px solid rgba(14,165,233,0.18);transition:var(--transition);position:relative;overflow:hidden;box-shadow:0 4px 20px rgba(14,165,233,0.08);}
.stat-box::before{content:'';position:absolute;top:0;left:0;right:0;height:4px;background:linear-gradient(90deg,var(--sky-light),var(--sky),var(--sky-dark));transform:scaleX(0);transition:transform 0.5s ease;}
.stat-box:hover::before{transform:scaleX(1)}
.stat-box:hover{transform:translateY(-8px);border-color:rgba(14,165,233,0.35);box-shadow:0 20px 50px rgba(14,165,233,0.15),0 4px 12px rgba(0,0,0,0.05)}
.stat-num{font-family:'Cinzel',serif;font-size:clamp(32px,5vw,68px);font-weight:700;background:linear-gradient(135deg,var(--sky-dark) 0%,var(--sky) 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;margin-bottom:10px;display:block;}
.stat-label{font-size:11px;color:var(--text-soft);letter-spacing:2.5px;text-transform:uppercase;font-weight:700}

/* ── PORTAL ── */
.portal-interface{background:rgba(255,255,255,0.8);border:1px solid rgba(14,165,233,0.2);border-radius:var(--radius-xl);padding:clamp(30px,5vw,60px) clamp(20px,4vw,50px);backdrop-filter:blur(20px);box-shadow:0 20px 60px rgba(14,165,233,0.12),0 4px 16px rgba(0,0,0,0.06);}
.portal-controls{display:flex;flex-direction:column;gap:20px;margin-bottom:40px}
.search-wrapper{position:relative}
.search-input{width:100%;padding:18px 28px;border-radius:var(--radius-lg);background:rgba(255,255,255,0.9);border:2px solid rgba(14,165,233,0.2);color:var(--text-dark);font-family:'Poppins',sans-serif;font-size:15px;outline:none;transition:all 0.3s;}
.search-input::placeholder{color:var(--text-soft)}
.search-input:focus{border-color:var(--sky);background:#fff;box-shadow:0 0 0 4px rgba(14,165,233,0.12)}
.filter-tabs{display:flex;gap:10px;flex-wrap:wrap}
.tab-btn{padding:11px 22px;border-radius:var(--radius-md);border:2px solid rgba(14,165,233,0.2);background:rgba(255,255,255,0.8);color:var(--text-body);font-size:clamp(10px,1vw,13px);font-weight:600;letter-spacing:1px;text-transform:uppercase;cursor:pointer;transition:var(--transition);font-family:'Poppins',sans-serif;}
.tab-btn:hover{border-color:var(--sky);color:var(--sky-dark);background:#fff}
.tab-btn.active{background:linear-gradient(135deg,var(--sky),var(--sky-dark));color:#fff;border-color:transparent;box-shadow:0 8px 22px rgba(14,165,233,0.3)}
.directory-status{margin-bottom:18px;font-size:14px;color:var(--sky-dark);font-weight:600;letter-spacing:0.5px}
.celebrities-scroll-container{max-height:520px;overflow-y:auto;padding-right:12px;border:1px solid rgba(14,165,233,0.1);border-radius:var(--radius-lg);background:rgba(240,249,255,0.5);}
.celebrities-scroll-container::-webkit-scrollbar{width:5px}
.celebrities-scroll-container::-webkit-scrollbar-thumb{background:rgba(14,165,233,0.35);border-radius:10px}
.celebrities-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;padding:18px}
.celebrity-item-card{background:rgba(255,255,255,0.9);border:1px solid rgba(14,165,233,0.15);border-radius:var(--radius-md);padding:18px 22px;display:flex;flex-direction:column;gap:5px;transition:var(--transition);position:relative;overflow:hidden;}
.celebrity-item-card::before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;background:linear-gradient(180deg,var(--sky-light),var(--sky));border-radius:3px 0 0 3px;}
.celebrity-item-card:hover{background:#fff;border-color:rgba(14,165,233,0.35);transform:translateY(-4px);box-shadow:0 10px 28px rgba(14,165,233,0.15)}
.celeb-name{font-size:14px;font-weight:600;color:var(--text-dark);letter-spacing:0.3px;white-space:nowrap;text-overflow:ellipsis;overflow:hidden}
.celeb-tag{font-size:10px;text-transform:uppercase;letter-spacing:1px;font-weight:700;color:var(--sky)}

/* ── MEMBERSHIP ── */
.membership-box{position:relative;border-radius:var(--radius-xl);padding:clamp(60px,9vw,110px) clamp(24px,5vw,65px);text-align:center;background:linear-gradient(135deg,var(--sky-dark) 0%,var(--sky-deep) 40%,#0c2340 100%);border:1px solid rgba(14,165,233,0.25);box-shadow:0 40px 90px rgba(14,165,233,0.2),inset 0 1px 0 rgba(255,255,255,0.1);overflow:hidden;}
.membership-box::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 80% 80% at 50% 120%,rgba(14,165,233,0.3) 0%,transparent 60%),radial-gradient(ellipse 60% 40% at 30% -20%,rgba(56,189,248,0.2) 0%,transparent 60%);pointer-events:none;}
.membership-box::after{content:'VIP';position:absolute;font-family:'Cinzel',serif;font-size:clamp(100px,18vw,280px);font-weight:900;color:rgba(255,255,255,0.04);bottom:-40px;right:-10px;pointer-events:none;line-height:1;}
.membership-box .shimmer-band{position:absolute;width:200%;height:2px;background:linear-gradient(90deg,transparent,rgba(255,255,255,0.25),transparent);animation:shimmerSlide 4s linear infinite;top:30%;}
.membership-box .shimmer-band:nth-child(2){top:65%;animation-delay:2s;opacity:0.5;}
@keyframes shimmerSlide{0%{transform:translateX(-50%)}100%{transform:translateX(0%)}}
.membership-box h2{font-family:'Cinzel',serif;font-size:clamp(26px,4.5vw,54px);color:#fff;margin-bottom:24px;letter-spacing:2px;position:relative;z-index:2;}
.membership-box p{max-width:800px;margin:0 auto 44px;font-size:clamp(14px,1.5vw,18px);color:rgba(255,255,255,0.88);font-weight:300;line-height:1.95;position:relative;z-index:2;}
.membership-box .hero-badge{position:relative;z-index:2;border-color:rgba(255,255,255,0.25);color:#fff;background:rgba(255,255,255,0.08);animation:none;transform:none;}

/* ── REVIEWS ── */
.review-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(18px,3vw,32px)}
.review-card{padding:clamp(30px,4vw,50px) clamp(22px,3vw,38px);background:rgba(255,255,255,0.85);border:1px solid rgba(14,165,233,0.15);border-radius:var(--radius-xl);box-shadow:0 4px 20px rgba(14,165,233,0.08);transition:var(--transition);position:relative;overflow:hidden;}
.review-card::before{content:'';position:absolute;top:0;left:0;right:0;height:4px;background:linear-gradient(90deg,var(--sky-light),var(--sky),var(--sky-dark));}
.review-card:hover{transform:translateY(-8px);box-shadow:0 20px 50px rgba(14,165,233,0.15);border-color:rgba(14,165,233,0.3)}
.review-stars{font-size:18px;color:#f59e0b;margin-bottom:22px;letter-spacing:5px}
.review-card h3{font-size:clamp(16px,1.8vw,20px);font-weight:600;color:var(--text-dark);margin-bottom:14px}
.review-card p{font-size:clamp(13px,1.2vw,15px);color:var(--text-body);line-height:1.85;font-weight:400;margin-bottom:22px}
.review-badge{display:inline-block;padding:5px 16px;border-radius:50px;background:rgba(14,165,233,0.1);border:1px solid rgba(14,165,233,0.25);color:var(--sky-dark);font-size:10px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;}

/* ── FORM ── */
.form-wrapper{display:grid;grid-template-columns:42% 58%;border-radius:var(--radius-xl);overflow:hidden;border:1px solid rgba(14,165,233,0.2);box-shadow:0 30px 80px rgba(14,165,233,0.12),0 8px 20px rgba(0,0,0,0.06);}
.form-left{padding:clamp(50px,7vw,90px) clamp(32px,5vw,60px);background:linear-gradient(135deg,var(--sky-dark) 0%,var(--sky-deep) 100%);display:flex;flex-direction:column;justify-content:center;position:relative;overflow:hidden;}
.form-left::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 80% 60% at 50% 110%,rgba(14,165,233,0.3) 0%,transparent 60%);}
.form-left h2{font-family:'Cinzel',serif;font-size:clamp(26px,3.5vw,46px);line-height:1.2;color:#fff;margin-bottom:24px;position:relative;z-index:1;}
.form-left p{color:rgba(255,255,255,0.82);font-weight:300;font-size:clamp(13px,1.2vw,15px);line-height:1.85;position:relative;z-index:1;}
.form-right{padding:clamp(50px,7vw,90px) clamp(28px,5vw,70px);background:#fff;}
.form-grid-2{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.form-group{margin-bottom:24px;position:relative}
.form-group.full-width{grid-column:span 2}
.form-group label{display:block;margin-bottom:10px;font-size:12px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;color:var(--sky-dark)}
.form-group input,.form-group textarea,.form-group select{width:100%;padding:16px 22px;border-radius:12px;border:2px solid rgba(14,165,233,0.15);background:rgba(240,249,255,0.5);color:var(--text-dark);font-family:'Poppins',sans-serif;font-size:14px;transition:all 0.3s;outline:none;}
.form-group input::placeholder,.form-group textarea::placeholder{color:var(--text-soft)}
.form-group input:focus,.form-group textarea:focus,.form-group select:focus{border-color:var(--sky);background:#fff;box-shadow:0 0 0 4px rgba(14,165,233,0.1);}
.form-group select option{background:#fff;color:var(--text-dark)}
.form-group textarea{color:var(--text-dark)}
.searchable-combobox-wrapper{position:relative;width:100%}
.searchable-combobox-wrapper::after{content:'▾';position:absolute;right:20px;top:50%;transform:translateY(-50%);color:var(--sky);font-size:16px;pointer-events:none;transition:transform 0.3s;}
.searchable-combobox-wrapper.active::after{transform:translateY(-50%) rotate(180deg)}
.combobox-options-panel{position:absolute;top:calc(100% + 6px);left:0;width:100%;max-height:240px;overflow-y:auto;background:#fff;border:2px solid rgba(14,165,233,0.3);border-radius:14px;z-index:999;box-shadow:0 20px 50px rgba(14,165,233,0.15);display:none;}
.combobox-options-panel::-webkit-scrollbar{width:5px}
.combobox-options-panel::-webkit-scrollbar-thumb{background:rgba(14,165,233,0.4);border-radius:10px}
.combobox-option-node{padding:13px 22px;font-size:13px;color:var(--text-dark);cursor:pointer;transition:all 0.2s;border-bottom:1px solid rgba(14,165,233,0.08);display:flex;justify-content:space-between;align-items:center;}
.combobox-option-node:last-child{border-bottom:none}
.combobox-option-node:hover{background:rgba(14,165,233,0.07);color:var(--sky-dark);padding-left:28px}
.combobox-option-node .node-category{font-size:10px;text-transform:uppercase;color:var(--sky);letter-spacing:0.5px}
.combobox-empty-message{padding:20px;text-align:center;color:var(--text-soft);font-size:13px}
.preferred-note{display:block;margin-top:7px;font-size:10px;color:var(--sky);letter-spacing:1px;text-transform:uppercase}
.submit-btn{width:100%;padding:20px;border:none;border-radius:14px;font-size:clamp(12px,1.2vw,14px);font-weight:800;letter-spacing:2px;text-transform:uppercase;cursor:pointer;background:linear-gradient(135deg,var(--sky) 0%,var(--sky-dark) 100%);color:#fff;transition:var(--transition);box-shadow:0 10px 32px rgba(14,165,233,0.25);font-family:'Poppins',sans-serif;position:relative;overflow:hidden;}
.submit-btn::before{content:'';position:absolute;top:0;left:-150%;width:110%;height:100%;background:linear-gradient(90deg,transparent,rgba(255,255,255,0.3),transparent);transform:skewX(-25deg);transition:0.7s;}
.submit-btn:hover::before{left:150%}
.submit-btn:hover{transform:translateY(-4px);box-shadow:0 18px 40px rgba(14,165,233,0.4);background:linear-gradient(135deg,var(--sky-mid),var(--sky))}

/* ══════════════════════════════════════
   TERMS & CONDITIONS
   ══════════════════════════════════════ */ú
.tc-block{
  margin-top:36px;
  border:1px solid rgba(14,165,233,0.2);
  border-radius:var(--radius-lg);
  background:rgba(240,249,255,0.6);
  overflow:hidden;
}
.tc-header{
  display:flex;align-items:center;gap:12px;
  padding:18px 26px;
  background:linear-gradient(90deg,rgba(14,165,233,0.08),rgba(3,105,161,0.05));
  border-bottom:1px solid rgba(14,165,233,0.12);
}
.tc-header-icon{font-size:20px;}
.tc-header-text{
  font-family:'Cinzel',serif;font-size:clamp(13px,1.4vw,16px);font-weight:700;
  letter-spacing:1.5px;color:var(--sky-dark);
}
.tc-preview{
  padding:20px 26px 0;
  font-size:clamp(12px,1.15vw,14px);color:var(--text-body);line-height:1.8;
  font-style:italic;opacity:0.85;
}
.tc-body{
  max-height:0;overflow:hidden;
  transition:max-height 0.6s cubic-bezier(0.16,1,0.3,1);
}
.tc-body.tc-open{max-height:2400px;}
.tc-inner{padding:20px 26px 26px;}
.tc-intro{
  font-size:clamp(12px,1.15vw,14px);color:var(--text-body);line-height:1.85;
  margin-bottom:20px;padding-bottom:16px;
  border-bottom:1px solid rgba(14,165,233,0.12);
}
.tc-list{list-style:none;display:flex;flex-direction:column;gap:10px;}
.tc-list li{
  display:flex;align-items:flex-start;gap:14px;
  font-size:clamp(12px,1.1vw,14px);color:var(--text-body);
  line-height:1.75;
  padding:10px 16px;
  border-radius:10px;
  border:1px solid rgba(14,165,233,0.1);
  background:rgba(255,255,255,0.6);
  transition:all 0.25s;
}
.tc-list li:hover{background:#fff;border-color:rgba(14,165,233,0.25);transform:translateX(4px);}
.tc-num{
  display:inline-flex;align-items:center;justify-content:center;
  min-width:26px;height:26px;border-radius:50%;
  background:linear-gradient(135deg,var(--sky),var(--sky-dark));
  color:#fff;font-size:11px;font-weight:700;flex-shrink:0;margin-top:1px;
}
.tc-toggle-wrap{
  padding:16px 26px;
  border-top:1px solid rgba(14,165,233,0.1);
  display:flex;justify-content:center;
}
.tc-toggle-btn{
  display:inline-flex;align-items:center;gap:8px;
  padding:11px 28px;border-radius:50px;
  border:2px solid rgba(14,165,233,0.3);
  background:rgba(255,255,255,0.8);
  color:var(--sky-dark);
  font-family:'Poppins',sans-serif;font-size:clamp(11px,1vw,13px);font-weight:700;
  letter-spacing:1.5px;text-transform:uppercase;cursor:pointer;
  transition:var(--transition);
}
.tc-toggle-btn:hover{
  background:linear-gradient(135deg,var(--sky),var(--sky-dark));
  color:#fff;border-color:transparent;
  box-shadow:0 8px 24px rgba(14,165,233,0.3);transform:translateY(-2px);
}
.tc-toggle-btn .tc-arrow{
  display:inline-block;transition:transform 0.4s cubic-bezier(0.16,1,0.3,1);font-size:14px;
}
.tc-toggle-btn.open .tc-arrow{transform:rotate(180deg);}

/* ── CONTACT SECTION ── */
.contact-section{background:linear-gradient(135deg,#f0f9ff 0%,#e0f4ff 50%,#f5fbff 100%);}
.contact-wrapper{display:grid;grid-template-columns:38% 62%;gap:clamp(24px,4vw,44px)}
.contact-card{padding:clamp(40px,5vw,60px) clamp(28px,4vw,48px);background:rgba(255,255,255,0.85);border:1px solid rgba(14,165,233,0.2);border-radius:var(--radius-xl);box-shadow:0 8px 32px rgba(14,165,233,0.1);}
.contact-card h3{font-family:'Cinzel',serif;font-size:clamp(20px,2.5vw,28px);color:var(--sky-dark);margin-bottom:32px;letter-spacing:1px}
.contact-item{margin-bottom:28px}
.contact-label{display:block;font-size:11px;letter-spacing:2px;color:var(--sky);margin-bottom:7px;font-weight:700;text-transform:uppercase}
.contact-item p,.contact-item a{font-size:clamp(14px,1.4vw,16px);color:var(--text-dark);text-decoration:none;transition:color 0.3s}
.contact-item a:hover{color:var(--sky)}
.location-grid{display:flex;flex-direction:column;gap:16px}

/* ── LOCATION CARDS ── */
.location-box{
  border-radius:18px;
  overflow:hidden;
  position:relative;
  transition:transform 0.35s ease, box-shadow 0.35s ease;
  cursor:default;
  border:1px solid rgba(14,165,233,0.18);
  background:#fff;
  box-shadow:0 4px 18px rgba(14,165,233,0.08);
  display:grid;
  grid-template-columns:auto 1fr;
  opacity:0;
  transform:translateX(-30px);
}
.location-box.loc-animated{
  opacity:1;
  transform:translateX(0);
  transition:opacity 0.55s ease, transform 0.55s cubic-bezier(0.16,1,0.3,1), box-shadow 0.35s ease;
}
.location-box:hover{transform:translateY(-5px);box-shadow:0 18px 48px rgba(14,165,233,0.15);}
.location-box.loc-animated:hover{transform:translateY(-5px);box-shadow:0 18px 48px rgba(14,165,233,0.15);}

.loc-accent{
  width:6px;
  flex-shrink:0;
}
.loc-usa .loc-accent{background:linear-gradient(180deg,#B22234,#3C3B6E);}
.loc-uk  .loc-accent{background:linear-gradient(180deg,#CF142B,#00247D);}
.loc-au  .loc-accent{background:linear-gradient(180deg,#00008B,#E01A22);}

.loc-body{
  padding:22px 28px;
  display:flex;
  align-items:center;
  gap:20px;
}
.loc-flag-emoji{
  font-size:clamp(36px,5vw,52px);
  flex-shrink:0;
  line-height:1;
  filter:drop-shadow(0 2px 6px rgba(0,0,0,0.12));
}
.loc-text{flex:1;}
.loc-country{
  font-family:'Cinzel',serif;
  font-size:clamp(14px,1.6vw,18px);
  font-weight:700;
  letter-spacing:1.5px;
  margin-bottom:6px;
}
.loc-usa .loc-country{color:#B22234;}
.loc-uk  .loc-country{color:#00247D;}
.loc-au  .loc-country{color:#00008B;}
.loc-address{
  font-size:clamp(12px,1.1vw,14px);
  color:var(--text-body);
  line-height:1.65;
  margin-bottom:10px;
  font-weight:400;
}
.loc-badge{
  display:inline-flex;align-items:center;gap:6px;
  padding:4px 14px;border-radius:50px;
  font-size:10px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;
}
.loc-usa .loc-badge{background:rgba(178,34,52,0.08);border:1px solid rgba(178,34,52,0.22);color:#B22234;}
.loc-uk  .loc-badge{background:rgba(0,36,125,0.08);border:1px solid rgba(0,36,125,0.22);color:#00247D;}
.loc-au  .loc-badge{background:rgba(0,0,139,0.07);border:1px solid rgba(0,0,139,0.2);color:#00008B;}

/* ── SITE INFO SECTION ── */
.site-info-section{background:linear-gradient(180deg,#0a2540 0%,#082f49 50%,#061e32 100%);padding:clamp(80px,11vw,140px) 0 60px;position:relative;overflow:hidden;}
.site-info-section::before{content:'';position:absolute;inset:0;pointer-events:none;background:radial-gradient(ellipse 60% 50% at 20% 30%,rgba(14,165,233,0.12) 0%,transparent 60%),radial-gradient(ellipse 50% 40% at 80% 70%,rgba(56,189,248,0.08) 0%,transparent 60%);}
.si-logo-wrap{display:flex;flex-direction:column;align-items:center;margin-bottom:clamp(56px,8vw,90px);position:relative;z-index:2;}
.si-logo-globe-ring{position:relative;width:100px;height:100px;display:flex;align-items:center;justify-content:center;margin-bottom:20px;}
.si-logo-globe-ring::before{content:'';position:absolute;width:130px;height:130px;border-radius:50%;border:1.5px dashed rgba(14,165,233,0.25);animation:ringRotate 20s linear infinite;}
.si-logo-globe-ring::after{content:'';position:absolute;width:115px;height:115px;border-radius:50%;border:1px solid rgba(56,189,248,0.15);animation:ringRotate 14s linear infinite reverse;}
@keyframes ringRotate{to{transform:rotate(360deg)}}
